# ── 必填 ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# 公開金鑰（anon / publishable），可以出現在瀏覽器
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 伺服器專用金鑰（service_role / secret）。絕對不要加 NEXT_PUBLIC_ 前綴，不要放進前端
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://你的網域
# 排程清理 API 的密鑰（自行產生一組亂數）
CRON_SECRET=

# ── 選填：登入方式（有填才會顯示按鈕；Google / Facebook / X 需先在 Supabase 後台啟用）──
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook,x
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ── 選填：影片上傳（Cloudflare Stream）。沒填時只開放 YouTube 連結 ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER=

# ── 選填：Cloudflare Turnstile 驗證碼（需同時在 Supabase Auth 設定啟用）──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
